# Copy this file to keystore.properties and fill in your own values.
#
#   cp keystore.properties.example keystore.properties
#
# keystore.properties is gitignored. Never commit it, and never commit the .jks
# file it points at.
#
# storeFile is resolved relative to the android/ directory.

storeFile=mptree-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=mptree
keyPassword=YOUR_KEY_PASSWORD
