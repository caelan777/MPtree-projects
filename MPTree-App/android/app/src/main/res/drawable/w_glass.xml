<?xml version="1.0" encoding="utf-8"?>
<!-- Clear (Pro): glass. Android cannot blur what lies under a widget, so this
     is the rest of glass: see-through white, brighter at the top, with a
     thin line of light round the edge and a brighter one along the top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient android:angle="270" android:startColor="#4DFFFFFF" android:centerColor="#26FFFFFF" android:endColor="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#73FFFFFF" />
        </shape>
    </item>
</layer-list>
