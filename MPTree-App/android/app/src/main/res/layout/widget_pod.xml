<?xml version="1.0" encoding="utf-8"?>
<!-- A small music player with a click wheel: screen on top, wheel below. Pro. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <FrameLayout
            android:id="@+id/widget_screen"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_screen_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_bg_small"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">
                <ImageView
                    android:id="@+id/widget_art"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_playing"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFB3B3B3"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp">
            <ImageView
                android:id="@+id/widget_wheel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_circle"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:paddingTop="9dp"
                android:paddingBottom="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="MENU"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
            <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="start|center_vertical"
            android:padding="8dp"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_w_prev"
            android:contentDescription="@string/action_previous" />
            <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="end|center_vertical"
            android:padding="8dp"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_w_next"
            android:contentDescription="@string/action_next" />
            <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|center_horizontal"
            android:padding="9dp"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_w_play"
            android:contentDescription="@string/widget_play_or_pause" />
            <ImageView
                android:id="@+id/widget_hub"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_circle"
                android:contentDescription="@string/widget_play_or_pause" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
