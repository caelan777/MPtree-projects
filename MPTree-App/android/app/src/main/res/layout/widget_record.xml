<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/w_bg"
        android:tint="#FF111111"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/w_disc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/album_art_logo"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_title"
            android:text="@string/app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/w_artist"
            android:text="@string/not_playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/w_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:visibility="gone"
                android:src="@drawable/ic_w_prev"
                android:contentDescription="@string/action_previous" />
            <FrameLayout
                android:id="@+id/w_play_box"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/action_play">
                <ImageView
                    android:id="@+id/w_play_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/w_circle"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/w_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="11dp"
                    android:src="@drawable/ic_w_play"
                    android:tint="#FF000000"
                    android:contentDescription="@null" />
            </FrameLayout>
            <ImageView
                android:id="@+id/w_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:visibility="gone"
                android:src="@drawable/ic_w_next"
                android:contentDescription="@string/action_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
