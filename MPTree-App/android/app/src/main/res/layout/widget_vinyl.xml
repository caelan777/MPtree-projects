<?xml version="1.0" encoding="utf-8"?>
<!-- A record with the cover as its label. The record itself is drawn in
     Widgets.java; a tap on it plays or pauses. Pro. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_disc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_play_or_pause" />
    <ImageView
        android:id="@+id/widget_paused"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_w_play"
        android:importantForAccessibility="no" />
    <FrameLayout
        android:id="@+id/widget_prev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="bottom|start"
        android:contentDescription="@string/action_previous">
        <ImageView
            android:id="@+id/widget_prev_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_circle"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/widget_prev_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_w_prev"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_next"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="@string/action_next">
        <ImageView
            android:id="@+id/widget_next_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_circle"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/widget_next_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_w_next"
            android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
