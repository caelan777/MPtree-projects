<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/w_bg_pill"
        android:tint="#FF111111"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">
        <FrameLayout
            android:id="@+id/w_play_box"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@string/action_play">
            <ImageView
                android:id="@+id/w_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/w_circle"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_play"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="13dp"
                android:src="@drawable/ic_w_play"
                android:tint="#FF000000"
                android:contentDescription="@null" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
            android:id="@+id/w_title"
            android:text="@string/app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:ellipsize="end" />
            <TextView
            android:id="@+id/w_artist"
            android:text="@string/not_playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:ellipsize="end" />
        </LinearLayout>
        <ImageView
            android:id="@+id/w_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:visibility="gone"
            android:src="@drawable/ic_w_prev"
            android:contentDescription="@string/action_previous" />
        <ImageView
            android:id="@+id/w_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:visibility="gone"
            android:src="@drawable/ic_w_next"
            android:contentDescription="@string/action_next" />
    </LinearLayout>

</FrameLayout>
