<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/w_bg"
        android:tint="#FF111111"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/w_cover"
            android:src="@drawable/album_art_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
            android:id="@+id/w_title"
            android:text="@string/app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:ellipsize="end" />
            <TextView
            android:id="@+id/w_artist"
            android:text="@string/not_playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFFFFFFF"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_w_prev"
            android:contentDescription="@string/action_previous" />
        <FrameLayout
            android:id="@+id/w_play_box"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/action_play">
            <ImageView
                android:id="@+id/w_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/w_circle"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/w_play"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_w_play"
                android:tint="#FF000000"
                android:contentDescription="@null" />
        </FrameLayout>
        <ImageView
            android:id="@+id/w_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_w_next"
            android:contentDescription="@string/action_next" />
    </LinearLayout>

</FrameLayout>
