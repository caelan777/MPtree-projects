<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- MPTree's AdMob app id. Not a secret: it ships inside the APK. Which
             ads show is decided by the ad unit in src/pro.ts (Google's test
             unit in the test build). The flags keep the ad SDK from starting
             anything when MPTree opens: it wakes up when someone asks for an ad. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-3909703327280410~7778718905" />
        <meta-data android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT" android:value="true" />
        <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION" android:value="true" />
        <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING" android:value="true" />
    </application>
</manifest>
