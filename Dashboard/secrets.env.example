# Copy this file to secrets.env and fill in what you have.
#
#   cp Dashboard/secrets.env.example Dashboard/secrets.env
#
# secrets.env is gitignored. Nothing in it ever reaches the dashboard page:
# the collector runs here, and only the numbers it produces are published.
# Every line is optional. A missing key marks that one panel unavailable and
# leaves the rest working, so fill them in whenever you get round to it.

# ── Cloudflare, for website visitor numbers and deploy history ────────────
# Cloudflare dashboard, My Profile, API Tokens, Create Token, Custom token.
# Three read permissions, nothing else:
#   Zone    > Zone             > Read
#   Zone    > Analytics        > Read
#   Account > Cloudflare Pages > Read
CLOUDFLARE_API_TOKEN=

# Only if the automatic lookup by domain name ever fails.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_PAGES_PROJECT=

# ── Google Play ──────────────────────────────────────────────────────────
# The service account key file itself goes at Dashboard/play-service-account.json
# (gitignored). Point somewhere else here if you prefer.
# PLAY_SERVICE_ACCOUNT_JSON=

# Play Console, Download reports, Statistics. The page shows a gs:// path;
# the bucket is the part after gs:// and before the first slash. Without this
# the reviews still come through, only install counts are missing.
PLAY_REPORTS_BUCKET=

# ── Cusdis ───────────────────────────────────────────────────────────────
# The comment COUNT needs nothing, it already works. This token is only to
# show what the comments actually say. Cusdis dashboard, your project,
# Settings, Project token.
CUSDIS_PROJECT_TOKEN=
