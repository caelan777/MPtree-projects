{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MPTree",
  "version": "0.1.1",
  "identifier": "net.mp-tree.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MPTree",
        "width": 1200,
        "height": 700,
        "minWidth": 380,
        "minHeight": 420,
        "backgroundColor": "#ffffff",
        "dragDropEnabled": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
