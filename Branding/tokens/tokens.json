{
  "$name": "MPTree design tokens",
  "$version": "0.1.0",
  "$updated": "2026-07-26",
  "$note": "MPTree is monochrome. Black and white carry the identity. The three state colours are functional UI signals only and are never used as brand or decoration.",

  "color": {
    "core": {
      "black": "#000000",
      "white": "#FFFFFF"
    },

    "dark": {
      "$comment": "The app's home ground. Values match MPTree-App/src/themes.ts DARK.",
      "bg": "#000000",
      "surface": "#111111",
      "card": "#141414",
      "player": "#0C0C0C",
      "sheet": "#141414",
      "input": "#252525",
      "dim": "#252525",
      "border": "#2A2A2A",
      "text": "#FFFFFF",
      "textSub": "#777777",
      "muted": "#777777",
      "accent": "#FFFFFF",
      "onAccent": "#000000",
      "overlay": "rgba(0,0,0,0.78)"
    },

    "light": {
      "$comment": "Values match MPTree-App/src/themes.ts LIGHT.",
      "bg": "#FFFFFF",
      "surface": "#F5F5F5",
      "card": "#EFEFEF",
      "player": "#F9F9F9",
      "sheet": "#FFFFFF",
      "input": "#E8E8E8",
      "dim": "#E0E0E0",
      "border": "#D8D8D8",
      "text": "#111111",
      "textSub": "#666666",
      "muted": "#888888",
      "accent": "#000000",
      "onAccent": "#FFFFFF",
      "overlay": "rgba(0,0,0,0.5)"
    },

    "state": {
      "$comment": "Functional only. Each one means exactly one thing, and nothing else may use it.",
      "like": { "value": "#E8445A", "means": "a track is liked" },
      "repeat": { "value": "#0EA5E9", "means": "repeat mode is on" },
      "shuffle": { "value": "#7C3AED", "means": "shuffle mode is on, or rows are selected" }
    }
  },

  "type": {
    "family": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "ui-monospace, 'Cascadia Code', 'SF Mono', Consolas, monospace"
    },
    "size": {
      "display": 64,
      "title": 24,
      "heading": 20,
      "body": 15,
      "small": 13,
      "caption": 12,
      "label": 11
    },
    "weight": { "regular": 400, "medium": 600, "bold": 700, "heavy": 800 },
    "tracking": { "display": "-0.04em", "title": "-0.02em", "body": "-0.006em", "label": "0.16em" },
    "leading": { "tight": 1.05, "snug": 1.3, "normal": 1.55 }
  },

  "radius": { "sm": 10, "md": 16, "lg": 22, "pill": 999 },

  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32, "3xl": 48 },

  "motion": {
    "fast": "150ms",
    "base": "250ms",
    "slow": "400ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "$comment": "Honour prefers-reduced-motion on every surface."
  },

  "logo": {
    "master": "source/mptree-mark.svg",
    "minSizePx": { "ui": 20, "favicon": 16 },
    "clearSpace": "One quarter of the mark's width on all sides."
  }
}
